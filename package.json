{
  "name": "opensimphy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "data:acquire": "node scripts/acquire-sources.mjs",
    "data:generate": "node scripts/generate-data.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:deploy": "npm run simulation:verify && VITE_ONELAB_ENABLED=true npm run build",
    "build:pages": "npm run build:deploy && node scripts/create-pages-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:engine": "vitest run tests/engine",
    "test:ui": "vitest run tests/ui",
    "e2e": "playwright test",
    "wasm:build": "tools/wasm/build.sh all",
    "wasm:acquire": "tools/wasm/acquire-sources.sh",
    "wasm:build:gmsh": "tools/wasm/build.sh gmsh",
    "wasm:build:getdp": "tools/wasm/build.sh getdp",
    "wasm:build:combined": "tools/wasm/build.sh combined",
    "wasm:reproducibility": "tools/wasm/verify-reproducible-build.sh",
    "wasm:reference": "tools/wasm/native-reference.sh",
    "wasm:measure": "node tools/wasm/measure-profiles.mjs",
    "wasm:lock:update": "node tools/wasm/update-artifact-lock.mjs --intentional",
    "simulation:stage": "node tools/wasm/stage-assets.mjs",
    "simulation:verify": "node tools/wasm/verify-staged-assets.mjs",
    "simulation:package": "node tools/wasm/package-release.mjs",
    "simulation:package:verify": "node tools/wasm/package-release.mjs --verify-determinism",
    "simulation:release:verify": "node tools/wasm/verify-release.mjs",
    "simulation:fetch": "node tools/wasm/fetch-release.mjs",
    "test:simulation": "vitest run tests/engine/onelab.spec.ts && playwright test tests/e2e/onelab.spec.ts --config playwright.simulation.config.ts",
    "test:simulation:separate": "VITE_ONELAB_PROFILE=separate playwright test tests/e2e/onelab.spec.ts --config playwright.separate.config.ts",
    "verify": "npm run data:generate && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "meshstep": "0.1.1",
    "plotly.js-dist-min": "2.35.3",
    "three": "0.180.0",
    "three-mesh-bvh": "0.9.2",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.10.7",
    "@types/plotly.js": "2.35.1",
    "@types/three": "0.180.0",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "jsdom": "25.0.1",
    "pug": "3.0.3",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vite-node": "3.2.4",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "3.2.7",
    "vue-tsc": "2.2.0",
    "wabt": "^1.0.37"
  }
}
