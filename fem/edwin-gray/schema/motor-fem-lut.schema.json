{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimphy.local/edwin-gray/motor-fem-lut.schema.json",
  "title": "Edwin Gray FEM browser lookup table",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contractVersion",
    "lutContract",
    "caseId",
    "status",
    "expectedAnglesDeg",
    "entries",
    "provenance"
  ],
  "properties": {
    "contract": {
      "const": "edwin-gray-browser-result"
    },
    "contractVersion": {
      "const": 1
    },
    "lutContract": {
      "const": "motor-fem-lut-v1"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["complete", "pending", "failed", "not-run"]
    },
    "expectedAnglesDeg": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "minimum": 0,
        "exclusiveMaximum": 360
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "publicationProfile": {
      "$ref": "#/$defs/publicationProfile"
    },
    "symmetryProof": {
      "$ref": "#/$defs/symmetryProof"
    },
    "validationPairs": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/validationPair" }
    }
  },
  "$defs": {
    "numberValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "status", "parameters", "observables", "provenance"],
      "properties": {
        "entryId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["complete", "pending", "failed", "not-run"]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rotorAngleDeg", "eventIndex", "excitationContract", "meshSizeM", "driveCurrentA"],
          "properties": {
            "rotorAngleDeg": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            "eventIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 26
            },
            "excitationContract": {
              "const": "edwin-gray-fem-excitation-event-map/v1"
            },
            "meshSizeM": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "driveCurrentA": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "observables": {
          "type": "object",
          "additionalProperties": false,
          "required": ["magneticEnergyJ", "coEnergyJ", "inductanceH"],
          "properties": {
            "magneticEnergyJ": {
              "$ref": "#/$defs/numberValue"
            },
            "coEnergyJ": {
              "$ref": "#/$defs/numberValue"
            },
            "inductanceH": {
              "$ref": "#/$defs/numberValue"
            }
          }
        },
        "provenance": {
          "$ref": "#/$defs/entryProvenance"
        }
      }
    },
    "entryProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic", "sourceFormat", "modelInputHash", "jobInputHash", "solver", "backend", "symmetryApplied", "artifacts"],
      "properties": {
        "synthetic": {
          "const": false
        },
        "sourceFormat": {
          "enum": ["getdp-table", "solver-json"]
        },
        "modelInputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "jobInputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "solver": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "symmetryApplied": {
          "type": "boolean"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "derivation": {
          "const": "symmetry-derived-from-job"
        },
        "rotationDeg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "sourceEventIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "sourceJobInputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceArtifactHashes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machineContractId", "machineRevision", "modelRevision", "topologyIdentity", "turns", "excitation", "modelInputHash"],
      "properties": {
        "machineContractId": { "type": "string", "minLength": 1 },
        "machineRevision": { "type": "integer", "minimum": 1 },
        "modelRevision": { "type": "integer", "minimum": 1 },
        "topologyIdentity": { "type": "string", "minLength": 1 },
        "turns": { "type": "integer", "minimum": 1 },
        "excitation": { "type": "string", "minLength": 1 },
        "modelInputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "publicationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "solvedEventIndices", "independentlySolvedJobCount", "symmetryDerivedEntryCount"],
      "properties": {
        "profileId": { "const": "fast-coarse-direct-mumps-v1" },
        "solvedEventIndices": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 5 } },
        "independentlySolvedJobCount": { "const": 6 },
        "symmetryDerivedEntryCount": { "const": 27 }
      }
    },
    "symmetryProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contractVersion", "status", "transformation", "inputs", "checks", "proofSha256"],
      "properties": {
        "contract": { "const": "edwin-gray-event-map-symmetry-proof" },
        "contractVersion": { "const": 1 },
        "status": { "const": "complete" },
        "transformation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eventOffset", "rotationDeg", "representativeEvents", "validationPartners", "classCount", "eventsPerClass"],
          "properties": {
            "eventOffset": { "const": 3 },
            "rotationDeg": { "const": 40 },
            "representativeEvents": { "const": [0, 1, 2] },
            "validationPartners": { "const": [3, 4, 5] },
            "classCount": { "const": 3 },
            "eventsPerClass": { "const": 9 }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eventMapSha256", "caseSha256", "geometrySha256"],
          "properties": {
            "eventMapSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "caseSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "geometrySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 79,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "evidence"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "const": "passed" },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        },
        "proofSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "validationPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representativeEvent", "validationEvent", "rotationDeg", "tolerance", "differences", "maximumRelativeDifference", "status", "representativeJobInputHash", "validationJobInputHash", "representativeArtifactHashes", "validationArtifactHashes"],
      "properties": {
        "representativeEvent": { "type": "integer", "minimum": 0, "maximum": 2 },
        "validationEvent": { "type": "integer", "minimum": 3, "maximum": 5 },
        "rotationDeg": { "const": 40 },
        "tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "differences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["magneticEnergyJ", "coEnergyJ", "inductanceH"],
          "properties": {
            "magneticEnergyJ": { "type": "number", "minimum": 0 },
            "coEnergyJ": { "type": "number", "minimum": 0 },
            "inductanceH": { "type": "number", "minimum": 0 }
          }
        },
        "maximumRelativeDifference": { "type": "number", "minimum": 0 },
        "status": { "const": "passed" },
        "representativeJobInputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "validationJobInputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "representativeArtifactHashes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "validationArtifactHashes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic", "limitations", "source"],
      "properties": {
        "synthetic": {
          "const": false
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
