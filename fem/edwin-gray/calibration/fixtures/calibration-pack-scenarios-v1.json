    { "id": "wall-limit", "mutation": "hard-deadline", "error": "resource/wall execution contract is invalid" },
    { "id": "missing-class", "mutation": "remove-class-2", "error": "exactly three jobs" },
    { "id": "pilot-model-mismatch", "mutation": "pilot-model-input-hash", "error": "does not match the calibration model" },
    { "id": "pilot-spec-mismatch", "mutation": "pilot-specification-hash", "error": "does not match the current convergence specification" },
    { "id": "pilot-sample-mismatch", "mutation": "pilot-angle-event-current-mesh", "error": "sample identity does not match" }
